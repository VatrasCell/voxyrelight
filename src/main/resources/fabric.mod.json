{
  "schemaVersion": 1,
  "id": "voxyrelight",
  "version": "${version}",
  "name": "Voxy Sky-Light Repair",
  "description": "Repairs missing sky light in existing Voxy LODs.",
  "authors": ["VatrasCell"],
  "contact": {
    "homepage": "https://github.com/VatrasCell/voxyrelight",
    "sources": "https://github.com/VatrasCell/voxyrelight",
    "issues": "https://github.com/VatrasCell/voxyrelight/issues"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["de.vatrascell.voxyrelight.VoxyRelightClient"]
  },
  "mixins": ["voxyrelight.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "voxy": "=0.2.19-beta"
  }
}
